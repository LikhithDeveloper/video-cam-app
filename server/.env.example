# TURN server settings. Needed when people are on different networks
# (mobile data, office Wi-Fi) and can't connect directly.
# Copy this file to server/.env for local use, or add these as
# Environment Variables in your hosting dashboard (e.g. Render).

# Option 1: Metered.ca (free plan) — https://dashboard.metered.ca
# METERED_DOMAIN=yourapp.metered.live
# METERED_API_KEY=your-api-key

# Option 2: any TURN server with a fixed username/password
# TURN_URLS=turn:your-turn-server.com:3478,turns:your-turn-server.com:5349
# TURN_USERNAME=user
# TURN_CREDENTIAL=secret
